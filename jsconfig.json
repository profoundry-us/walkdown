{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "lib/**/*.js"
  ],
  "exclude": [
    "lib/viewer",
    "lib/skills"
  ]
}
