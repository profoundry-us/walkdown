#!/usr/bin/env node
/*
 * Nothing is presented to Topher with the agent tier still owed on it.
 *
 * A rule built, split or reworded comes back never or stale in the agent
 * column, and an agent that ends its turn there hands over work nobody has
 * looked at. Topher found five such rules in his 2026-09-23 walkdown and asked
 * for this gate. It runs at turn end, not per edit: owing the tier mid-change
 * is normal, and ending a turn with it owed is what is refused.
 *
 * A sweep is exempt. `walkdown sweep --tiers agent` makes every verdict stale
 * at once, on purpose, and the sitting that follows takes many turns; a gate
 * that blocked every one of them would make sweeps impossible. So a cell
 * stale ONLY because of a sweep is left to the sitting. One that was also
 * reworded or lost its check is still owed. A fail is not counted: it was
 * judged, and its thread says what is owed. A pass older than a fix a
 * thread claims IS counted (`unjudgedFix`): the pass is of the code before
 * the fix, and four such rules slipped past the first cut of this gate.
 *
 * From the hook's own home, imported first, for the reason lint-registered
 * gives: the answer must not depend on whose laptop ran it.
 */
import { spawnSync } from "node:child_process";
import { mkdirSync } from "node:fs";
import { resolve } from "node:path";

const root = resolve(import.meta.dirname, "..", "..");
const home = resolve(root, "tmp", "hook-home");
mkdirSync(home, { recursive: true });
const env = { ...process.env, WALKDOWN_HOME: home, NO_COLOR: "1" };
const cli = resolve(root, "bin", "walkdown.js");

// The hook's home is a cache of this checkout's registration, so a layout
// from before ADR 0014 left in it is moved rather than refused.
spawnSync(process.execPath, [cli, "upgrade"], { cwd: root, env, encoding: "utf8" });
const imported = spawnSync(process.execPath, [cli, "blueprints", "import", root, "--all"], { cwd: root, env, encoding: "utf8" });
if (imported.status !== 0) {
  process.stdout.write(imported.stdout + imported.stderr);
  process.exit(imported.status ?? 1);
}
// status exits non-zero whenever anything fails; the JSON is on stdout either way.
const out = spawnSync(process.execPath, [cli, "status", "--json"], { cwd: root, env, encoding: "utf8", maxBuffer: 64 * 1024 * 1024 });
let report;
try {
  report = JSON.parse(out.stdout);
} catch {
  process.stdout.write(out.stdout + out.stderr);
  process.exit(1);
}
// With several blueprints the answer is one per blueprint (ADR 0011); this
// repository has two since ADR 0013 split the CLI out of the panel's.
const rows = (report.blueprints ?? [report]).flatMap((b) => b.rows ?? []);
// An unbuilt rule owes nothing yet: there is no build to judge, and status
// queues it to no judge either. Its first ask is a person approving its
// wording, beside its screen's proposed design ("Design comes first", ADR
// 0015). It comes due the moment a recorded check makes it built. Until
// 2026-10-09 every rule here was built the turn it was written, so this
// never had to be said.
const owed = rows
  .filter((r) => (r.verify ?? []).includes("agent"))
  .filter((r) => r.built !== false)
  .filter((r) => {
    const a = r.agent ?? { state: "never" };
    if (a.state === "never" || r.unjudgedFix) return true;
    if (a.state !== "stale") return false;
    return !a.sweptBy || Boolean(a.staleBy);
  });
if (!owed.length) {
  console.log("agent tier: nothing owed outside a sweep");
  process.exit(0);
}
console.log(`agent tier: ${owed.length} rule(s) owed. Judge them before presenting the work (/walkdown:judge, on a scratch copy):`);
for (const r of owed) {
  const why = r.unjudgedFix ? `fix claimed in ${r.unjudgedFix.thread ?? r.unjudgedFix}` : r.agent?.staleBy ?? "";
  console.log(`  ${r.agent?.state ?? "never"}${why ? ` (${why})` : ""}  ${r.rule}`);
}
process.exit(1);
